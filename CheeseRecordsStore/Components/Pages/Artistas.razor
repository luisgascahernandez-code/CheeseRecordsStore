@page "/artistas"
@rendermode InteractiveServer

<PageTitle> CHEESE RECORDS</PageTitle>

<div class="contenedor-pagina">
    <div class="capa-oscura"></div>

    <div class="contenido-principal" style="position: relative; z-index: 10;">

        <!-- BARRA UNIFICADA -->
        <nav style="background: rgba(17, 17, 17, 0.9); padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f39c12; margin-bottom: 20px; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 30px;">
                <h2 style="color: #f39c12; margin: 0; font-size: 2.5em; font-weight: 900; letter-spacing: 1px;">CHEESE RECORDS</h2>
                <a href="/" style="color: white; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">💿 Catálogo</a>
                <a href="/dashboard" style="color: white; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">📊 Dashboard</a>
                <a href="/artistas" style="color: #f39c12; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">🎤 Crew</a>
            </div>
            <!-- Contrapeso derecho invisible -->
            <div style="width: 180px;"></div>
        </nav>

        <!-- LEMA SIEMPRE VISIBLE -->
        <header style="text-align: center; margin-bottom: 45px; margin-top: 10px;">
            <p style="color: #e0e0e0; font-size: 1.35em; font-style: italic; letter-spacing: 1.5px; font-weight: 500; text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
                "Hijos de la suerte | La calle y la disciplina crean el talento de barrio | Repartiendo el queso"
            </p>
        </header>

        <!-- SECCIÓN DEL CREW ESTILO BOOKING -->
        <section style="text-align: center; margin-top: 20px;">
            <h3 style="color: #fff; margin-bottom: 40px; font-size: 2em; text-transform: uppercase; font-weight: 900; letter-spacing: 2px;">
                Crew: <span style="color: #f39c12;">Hijos de la Suerte</span>
            </h3>

            <div style="display: flex; gap: 40px; justify-content: center; flex-wrap: wrap;">

                <!-- TARJETA ARTISTA 1 (GASKKA) -->
                <div style="background: rgba(34, 34, 34, 0.9); border-radius: 15px; border: 1px solid #444; width: 300px; overflow: hidden; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.5); display: flex; flex-direction: column;">
                    <!-- Contenedor de la foto tamaño completo -->
                    <div style="width: 100%; height: 400px; border-bottom: 4px solid #f39c12;">
                        <img src="images/mifoto.jpg" alt="GASKKA" style="width: 100%; height: 100%; object-fit: cover; object-position: top;" onerror="this.src='https://via.placeholder.com/300x400/111/f39c12?text=FOTO'" />
                    </div>
                    <!-- Contenedor de la información -->
                    <div style="padding: 20px;">
                        <h2 style="color: #fff; margin: 0 0 5px 0; font-size: 1.8em; font-weight: 900;">GASKKA</h2>
                        <p style="color: #f39c12; margin: 0; font-size: 1em; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Fundador / Artista</p>
                    </div>
                </div>

                <!-- TARJETA ARTISTA 2 (ES EL KLIPPER) -->
                <div style="background: rgba(34, 34, 34, 0.9); border-radius: 15px; border: 1px solid #444; width: 300px; overflow: hidden; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.5); display: flex; flex-direction: column;">
                    <!-- Contenedor de la foto tamaño completo -->
                    <div style="width: 100%; height: 400px; border-bottom: 4px solid #3498db;">
                        <img src="images/klipper.jpg" alt="ES EL KLIPPER" style="width: 100%; height: 100%; object-fit: cover; object-position: top;" onerror="this.src='https://via.placeholder.com/300x400/111/3498db?text=FOTO'" />
                    </div>
                    <!-- Contenedor de la información -->
                    <div style="padding: 20px;">
                        <h2 style="color: #fff; margin: 0 0 5px 0; font-size: 1.8em; font-weight: 900;">ES EL KLIPPER</h2>
                        <p style="color: #3498db; margin: 0; font-size: 1em; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Fundador / Productor</p>
                    </div>
                </div>

            </div>
        </section>

    </div>
</div>

@code {
    // Lógica del crew
}