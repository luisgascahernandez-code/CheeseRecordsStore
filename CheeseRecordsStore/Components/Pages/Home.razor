@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.IO
@using CheeseRecordsStore.Models
@using CheeseRecordsStore.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Hosting
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment Env

<PageTitle>Inicio - CHEESE RECORDS</PageTitle>

<div class="contenedor-pagina">
    <div class="capa-oscura"></div>

    <div class="contenido-principal" style="position: relative; z-index: 10;">

        <!-- BARRA UNIFICADA -->
        <nav style="background: rgba(17, 17, 17, 0.9); padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f39c12; margin-bottom: 20px; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 30px;">
                <h2 style="color: #f39c12; margin: 0; font-size: 2.5em; font-weight: 900; letter-spacing: 1px;">CHEESE RECORDS</h2>
                <a href="/" style="color: #f39c12; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">Catálogo</a>
                <a href="/dashboard" style="color: white; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">Dashboard</a>
                <a href="/artistas" style="color: white; text-decoration: none; font-weight: bold; font-size: 1.1em; transition: 0.3s;">Crew</a>
            </div>
            <!-- Contrapeso derecho -->
            <div style="width: 180px; text-align: right;">
                <button class="btn-azul" @onclick="AbrirModalAgregar" style="width: 100%; padding: 10px 20px; border-radius: 20px; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                    ➕ Agregar Beat
                </button>
            </div>
        </nav>

        <!-- LEMA SIEMPRE VISIBLE -->
        <header style="text-align: center; margin-bottom: 45px; margin-top: 10px;">
            <p style="color: #e0e0e0; font-size: 1.35em; font-style: italic; letter-spacing: 1.5px; font-weight: 500; text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
                "Hijos de la suerte | La calle y la disciplina crean el talento de barrio | Repartiendo el queso"
            </p>
        </header>

        <!-- CATÁLOGO DE BEATS -->
        <section class="cuadricula-beats">
            @if (listaBeats == null)
            {
                <p>Cargando...</p>
            }
            else
            {
                @foreach (var beat in listaBeats)
                {
                    <div class="tarjeta-beat">
                        <img src="images/@beat.ImagenUrl" alt="Portada @beat.Nombre" />
                        <h2>@beat.Nombre</h2>
                        <!-- Aquí leemos el nombre del género desde la nueva tabla relacionada -->
                        <p style="color: #ccc; font-size: 0.9em; margin-bottom: 10px;">@(beat.Genero?.Nombre ?? "Sin género")</p>
                        <button class="btn-lapiz" @onclick="() => AbrirEdicion(beat)">✏️</button>
                    </div>
                }
            }
        </section>

        <!-- BANNER DE CONTACTO (EFECTO CRISTAL NARANJA) -->
        <section style="background: rgba(243, 156, 18, 0.4); backdrop-filter: blur(6px); border: 1px solid rgba(243, 156, 18, 0.5); padding: 40px 20px; border-radius: 10px; margin-top: 50px; margin-bottom: 20px; text-align: center; box-shadow: 0 10px 20px rgba(0,0,0,0.5);">
            <h2 style="color: #fff; margin-bottom: 15px; font-weight: 900; font-size: 2.2em; text-transform: uppercase; text-shadow: 2px 2px 5px rgba(0,0,0,0.8);">¿Listo para grabar?</h2>
            <p style="color: #eee; font-size: 1.2em; font-weight: bold; max-width: 600px; margin: 0 auto 25px auto; text-shadow: 1px 1px 4px rgba(0,0,0,0.9);">
                ¿Te apasiona la música y no sabes por dónde empezar? En Cheese Records te producimos. Contáctanos y hagamos el próximo hit.
            </p>
            <a href="https://wa.me/522231759353?text=¡Qué%20onda!%20Vengo%20de%20la%20página%20de%20Cheese%20Records%20y%20quiero%20hacer%20un%20hit."
               target="_blank"
               style="display: inline-block; background: #111; color: #f39c12; padding: 15px 35px; border-radius: 30px; font-weight: bold; font-size: 1.2em; text-decoration: none; box-shadow: 0 5px 15px rgba(0,0,0,0.6); transition: transform 0.2s;">
                💬 Enviar mensaje
            </a>
        </section>

    </div>

    <!-- MODAL AGREGAR BEAT -->
    @if (mostrarModalAgregar)
    {
        <div class="modal-fondo">
            <div class="modal-contenido">
                <h3>Nuevo Beat</h3>

                <!-- SEGURO ANTI-DUPLICADOS (Alerta visual) -->
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div style="background-color: #e74c3c; color: white; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-weight: bold; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                        ⚠️ @mensajeError
                    </div>
                }

                <EditForm Model="beatFormulario" OnValidSubmit="AgregarBeat">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="beatFormulario.Nombre" placeholder="Nombre de la pista" class="input-menu" />
                    <ValidationMessage For="@(() => beatFormulario.Nombre)" class="texto-error" />

                    <label class="etiqueta-archivo" style="margin-top: 10px; display: block;">Género Musical:</label>
                    <InputSelect @bind-Value="generoFormulario" class="input-menu">
                        <option value="Cumbia">Cumbia</option>
                        <option value="Reggeaton">Reggeaton</option>
                        <option value="HipHop">Hip-Hop</option>
                        <option value="Trap">Trap</option>
                        <option value="Rap">Rap</option>
                        <option value="Corridos">Corridos</option>
                        <option value="Dembow">Dembow</option>
                        <option value="RnB">R&B</option>
                        <option value="Pop">Pop</option>
                    </InputSelect>

                    <label class="etiqueta-archivo" style="margin-top: 10px; display: block;">Portada del Beat:</label>
                    <InputFile OnChange="CargarImagen" class="input-menu" accept="image/*" />
                    <ValidationMessage For="@(() => beatFormulario.ImagenUrl)" class="texto-error" />

                    <div class="modal-botones" style="margin-top: 20px;">
                        <button type="submit" class="btn-azul">Subir Beat</button>
                        <button type="button" class="btn-gris" @onclick="CerrarModalAgregar">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- MODAL EDITAR BEAT -->
    @if (beatEnEdicion != null)
    {
        <div class="modal-fondo">
            <div class="modal-contenido">
                <h3>Editar Beat</h3>
                <input @bind="nombreEdicion" placeholder="Nombre" class="input-menu" />

                <select @bind="generoEdicion" class="input-menu" style="margin-top: 10px; margin-bottom: 15px;">
                    <option value="Cumbia">Cumbia</option>
                    <option value="Reggeaton">Reggeaton</option>
                    <option value="HipHop">Hip-Hop</option>
                    <option value="Trap">Trap</option>
                    <option value="Rap">Rap</option>
                    <option value="Corridos">Corridos</option>
                    <option value="Dembow">Dembow</option>
                    <option value="RnB">R&B</option>
                    <option value="Pop">Pop</option>
                </select>

                <div class="modal-botones">
                    <button class="btn-azul" @onclick="GuardarEdicion">Guardar</button>
                    <button class="btn-rojo" @onclick="EliminarDesdeEdicion">Eliminar</button>
                    <button class="btn-gris" @onclick="CerrarEdicion">Cancelar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Beat> listaBeats = new();
    private Beat beatFormulario = new();
    private Beat? beatEnEdicion = null;

    // Variables para los formularios y alertas
    private string nombreEdicion = "";
    private string generoEdicion = "Trap";
    private string generoFormulario = "Trap";
    private string mensajeError = "";

    private IBrowserFile? archivoSeleccionado;
    private bool mostrarModalAgregar = false;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // Include(b => b.Genero) asegura que traigamos los datos de la tabla relacionada
        listaBeats = await context.Beats.Include(b => b.Genero).ToListAsync();
    }

    private void AbrirModalAgregar()
    {
        mensajeError = "";
        mostrarModalAgregar = true;
    }

    private void CerrarModalAgregar()
    {
        mostrarModalAgregar = false;
        mensajeError = "";
        beatFormulario = new();
    }

    private async Task AgregarBeat()
    {
        using var context = DbFactory.CreateDbContext();

        // 1. VALIDACIÓN ANTI-DUPLICADOS
        bool yaExiste = await context.Beats.AnyAsync(b => b.Nombre.ToLower() == beatFormulario.Nombre.ToLower());
        if (yaExiste)
        {
            mensajeError = $"¡El beat '{beatFormulario.Nombre}' ya existe en el catálogo! Ingresa un nombre diferente.";
            return; // Detiene el proceso para que no se duplique
        }

        mensajeError = ""; // Limpiamos el error si pasa la validación

        // 2. GUARDADO DE IMAGEN
        if (archivoSeleccionado != null)
        {
            var rutaCarpeta = Path.Combine(Env.WebRootPath, "images");
            if (!Directory.Exists(rutaCarpeta)) Directory.CreateDirectory(rutaCarpeta);
            var rutaArchivo = Path.Combine(rutaCarpeta, archivoSeleccionado.Name);
            using var stream = new FileStream(rutaArchivo, FileMode.Create);
            await archivoSeleccionado.OpenReadStream(maxAllowedSize: 15000000).CopyToAsync(stream);
        }

        // 3. USO DE LA TABLA RELACIONADA (Generos)
        var generoDb = await context.Generos.FirstOrDefaultAsync(g => g.Nombre == generoFormulario);
        if (generoDb == null)
        {
            generoDb = new Genero { Nombre = generoFormulario };
            context.Generos.Add(generoDb);
            await context.SaveChangesAsync();
        }

        // Asignamos el ID foráneo
        beatFormulario.GeneroId = generoDb.Id;

        context.Beats.Add(beatFormulario);
        await context.SaveChangesAsync();

        // Refrescamos la lista trayendo la relación
        listaBeats = await context.Beats.Include(b => b.Genero).ToListAsync();

        beatFormulario = new();
        archivoSeleccionado = null;
        mostrarModalAgregar = false;
    }

    private void CargarImagen(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            archivoSeleccionado = e.File;
            beatFormulario.ImagenUrl = e.File.Name;
        }
    }

    private void AbrirEdicion(Beat beat)
    {
        beatEnEdicion = beat;
        nombreEdicion = beat.Nombre;
        generoEdicion = beat.Genero?.Nombre ?? "Trap";
    }

    private async Task GuardarEdicion()
    {
        if (beatEnEdicion != null)
        {
            using var context = DbFactory.CreateDbContext();

            // 1. Buscamos el beat "fresco" en la base de datos para no confundir la memoria
            var beatFresco = await context.Beats.FindAsync(beatEnEdicion.Id);

            if (beatFresco != null)
            {
                // 2. Buscamos o creamos el género
                var generoDb = await context.Generos.FirstOrDefaultAsync(g => g.Nombre == generoEdicion);
                if (generoDb == null)
                {
                    generoDb = new Genero { Nombre = generoEdicion };
                    context.Generos.Add(generoDb);
                    await context.SaveChangesAsync();
                }

                // 3. Actualizamos los datos en el beat fresco
                beatFresco.Nombre = nombreEdicion;
                beatFresco.GeneroId = generoDb.Id;

                // Guardamos los cambios reales
                await context.SaveChangesAsync();

                // Recargamos la lista limpia
                listaBeats = await context.Beats.Include(b => b.Genero).ToListAsync();
                beatEnEdicion = null;
            }
        }
    }

    private async Task EliminarDesdeEdicion()
    {
        if (beatEnEdicion != null)
        {
            using var context = DbFactory.CreateDbContext();
            context.Beats.Remove(beatEnEdicion);
            await context.SaveChangesAsync();
            listaBeats = await context.Beats.Include(b => b.Genero).ToListAsync();
            beatEnEdicion = null;
        }
    }

    private void CerrarEdicion() => beatEnEdicion = null;
}